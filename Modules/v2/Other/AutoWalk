local function createToggle(text, order, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 190, 0, 36)
	frame.BackgroundColor3 = THEME.BarEmpty
	frame.LayoutOrder = order
	frame.Parent = settingsContainer
	addCorner(frame, 8)
	addStroke(frame, 1, THEME.Outline)
	
	local lbl = Instance.new("TextLabel")
	lbl.Text = text
	lbl.Size = UDim2.new(0, 130, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = THEME.TextDim
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = frame
	
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 20, 0, 20)
	toggleBtn.Position = UDim2.new(1, -30, 0.5, -10)
	toggleBtn.BackgroundColor3 = THEME.Background
	toggleBtn.Text = ""
	toggleBtn.Parent = frame
	addCorner(toggleBtn, 4)
	addStroke(toggleBtn, 1, THEME.TextDim)
	
	local toggled = false
	toggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		if toggled then
			TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.BarFilled}):Play()
			toggleBtn.UIStroke.Color = THEME.BarDark
			lbl.TextColor3 = THEME.Text
		else
			TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.Background}):Play()
			toggleBtn.UIStroke.Color = THEME.TextDim
			lbl.TextColor3 = THEME.TextDim
		end
		callback(toggled)
	end)
end

