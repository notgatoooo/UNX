local function getAvoidanceDirection(targetDir)
	local checkDist = 10 
	
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {character, pathVisualizer}
	params.FilterType = Enum.RaycastFilterType.Exclude

	local hitMain = workspace:Raycast(rootPart.Position, targetDir * checkDist, params)
	if not hitMain then return targetDir end
	
	local lookCf = CFrame.lookAt(Vector3.zero, targetDir)
	local rightVec = lookCf.RightVector
	local leftVec = -rightVec
	local backVec = -targetDir
	
	local canGoRight = not workspace:Raycast(rootPart.Position, rightVec * checkDist, params)
	local canGoLeft = not workspace:Raycast(rootPart.Position, leftVec * checkDist, params)
	local canGoBack = not workspace:Raycast(rootPart.Position, backVec * checkDist, params)
	
	if canGoRight then return rightVec
	elseif canGoLeft then return leftVec
	elseif canGoBack then return backVec
	else return Vector3.zero end
end

RunService.RenderStepped:Connect(function(dt)
	if not character or not humanoid or not rootPart then return end

	if isMoving then
		local baseDir = moveDirection
		if relativeToCamera then
			local camCFrame = camera.CFrame
			baseDir = (camCFrame:VectorToWorldSpace(moveDirection)).Unit
			baseDir = Vector3.new(baseDir.X, 0, baseDir.Z).Unit
		end
		
		if wallAvoidanceEnabled then
			baseDir = getAvoidanceDirection(baseDir)
		end
		
		humanoid:Move(baseDir, false)
		
		if showPathEnabled then
			pathVisualizer.Transparency = 0.5
			pathVisualizer.Position = rootPart.Position + (baseDir * 3)
		else
			pathVisualizer.Transparency = 1
		end
		
		if timedWalkEnabled then
			currentWalkTime = currentWalkTime + dt
			if currentWalkTime >= walkDuration then
				isMoving = false
				humanoid:Move(Vector3.zero)
				pathVisualizer.Transparency = 1
			end
		end
	else
		pathVisualizer.Transparency = 1
	end
end)

